# Copy to backend/.env. Everything defaults to mock providers + local dev server.
HOLODECK_STATION=laptop
# TEMPORAL_ADDRESS=reinvent2026-demos.xxxxx.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=reinvent2026-demos.xxxxx
# TEMPORAL_API_KEY=
# Photo booth image provider: mock | bedrock | openai.
# Leave unset to use openai when OPENAI_API_KEY is set, otherwise mock.
# HOLODECK_IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# HOLODECK_OPENAI_IMAGE_MODEL=gpt-image-2.5-flare   # or gpt-image-2.5-sunburst (sharper edits, slower)
# HOLODECK_OPENAI_IMAGE_QUALITY=medium              # low | medium | high (higher = slower, pricier)
# HOLODECK_OPENAI_IMAGE_SIZE=1536x1024
# HOLODECK_OPENAI_INPUT_FIDELITY=high               # likeness to the reference photo (high | low | empty to omit)
# HOLODECK_PHOTOBOOTH_STYLE=inspired                # inspired (new scene, their likeness) | photo (edit their photo)
# HOLODECK_OPENAI_MODERATION=auto                   # auto | low
# HOLODECK_OPENAI_VISION_MODEL=gpt-6-luna          # photo analysis (framing + face boxes)
HOLODECK_LLM_PROVIDER=mock          # mock | bedrock | agentcore
HOLODECK_EMAIL_PROVIDER=outbox      # outbox | sendgrid
HOLODECK_CHAOS_RATE=0.25            # chance a mock AI call fails once (shows retries)
AWS_REGION=us-west-2
# AWS_PROFILE=reinvent2026
# HOLODECK_AGENTCORE_RUNTIME_ARN=
# SENDGRID_API_KEY=
# HOLODECK_EMAIL_LOGO_URL=https://<cdn>/temporal-logo-white.png  # else inline attachment (SendGrid) / embedded (outbox)
